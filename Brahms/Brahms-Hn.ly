firsthorn = \relative c' {
  \clef treble
  \key c \major
  e'4.\p e8           % mm1-4
  f4 e
  r2
  d8.[ e16 f e]
  e4\mf( d8 r         % mm5-8
  e4. e
  f4 e
  r2
