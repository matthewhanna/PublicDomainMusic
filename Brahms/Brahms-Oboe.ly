firstoboe = \relative c' {
  \key bes \major
  d'8.\p[ ees16 d8 d]           % mm1-4
  ees4^\tenuto d^\tenuto
  c4 bes
  c8. d16 ees( c) d( bes)
  d4( c16) a bes c            % mm5-8
  d8.\f ees16 d8 d
  ees4 d
  c4 bes
  c8. d16 bes8 a                % mm9-10
  c4( bes8) r
}

secondoboe = \relative c' {
  \key bes \major
  f8.\p[ g16 f8 f]              % mm1-4
  g4^\tenuto f^\tenuto
  a8 d, d4
  g4. g8
  bes4( a16) f g a              % mm5-8
  bes8.\f g16 f8 f
  g4 f4
  a8 d, d4
  g4 d8 c                       % mm9-10
  ees4( d8) r
}